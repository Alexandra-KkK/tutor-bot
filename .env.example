# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Telegram ID администраторов через запятую (узнать свой ID можно у @userinfobot).
# Им приходят обращения в поддержку, им доступны команды /admin и /grant.
# Можно оставить пустым: владельцем станет первый, кто зарегистрируется как преподаватель.
ADMIN_IDS=

# Файл базы данных
DB_PATH=data/bot.sqlite3

# Часовой пояс по умолчанию для новых преподавателей (смещение от UTC, Москва = 3)
DEFAULT_TZ=3

# Подписка для преподавателей. SUBSCRIPTION=off — бот полностью бесплатный (например, только для себя)
SUBSCRIPTION=on
TRIAL_DAYS=15
PRICE_RUB=299
SUB_DAYS=30

# Токен платёжного провайдера из @BotFather -> Payments (например, ЮKassa).
# Пока пусто — кнопка оплаты работает как заглушка.
PAYMENT_PROVIDER_TOKEN=

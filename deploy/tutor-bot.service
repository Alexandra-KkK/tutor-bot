# Запуск бота как службы на Linux-сервере (Ubuntu/Debian).
# Скопируйте в /etc/systemd/system/tutor-bot.service, поправьте пути и выполните:
#   sudo systemctl daemon-reload && sudo systemctl enable --now tutor-bot
[Unit]
Description=Telegram-бот для репетитора
After=network-online.target

[Service]
WorkingDirectory=/opt/tutor-bot
ExecStart=/opt/tutor-bot/.venv/bin/python run.py
Restart=always
RestartSec=5
User=tutorbot

[Install]
WantedBy=multi-user.target

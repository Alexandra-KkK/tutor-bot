# Служба бота на сервере Ubuntu. Ставится скриптом deploy/install.sh,
# вручную: sudo cp deploy/tutor-bot.service /etc/systemd/system/ && sudo systemctl enable --now tutor-bot
[Unit]
Description=Telegram-бот для репетитора
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/tutor-bot
ExecStart=/opt/tutor-bot/.venv/bin/python run.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
